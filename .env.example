# -----------------------------------------------------------------------------
# Hope Network Discord Bot Configuration (.env)
# -----------------------------------------------------------------------------

# Discord Bot Token (Get from Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Secret key required for authorizing webhook requests (Node verification & Social Media API)
WEBHOOK_SECRET=your_secure_webhook_secret_here

# HTTP API Port (Default: 8080)
PORT=8080

# Persistent Data Storage Directory (e.g., /data for Render persistent disk)
DATA_DIR=./data

# XP Reward Amounts
DISBOARD_BUMP_XP=30
NODE_OPERATOR_INVITE_XP=100

# Channel / Role Configuration (Optional - override defaults)
LOG_CHANNEL_ID=1458122793769107456
WELCOME_CHANNEL_ID=1343345592675336194
ROLES_CHANNEL_ID=1435607673176461413
TICKET_CHANNEL_ID=1437368945198895155
TICKET_CATEGORY_ID=1457266525013676043
NFT_ROLE_DISCORD_ID=1486257857635680326

# Official DISBOARD Bot ID (Default: 302050872383242240)
DISBOARD_BOT_ID=302050872383242240
